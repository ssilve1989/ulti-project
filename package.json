{
  "name": "ulti-project",
  "description": "Ulti-Project monorepo root",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc -b apps/bot/tsconfig.build.json",
    "build:all": "pnpm -r --if-present run build",
    "build:check": "pnpm -r run build:check && tsc -b tsconfig.typecheck.json",
    "check": "biome check",
    "commit": "git-cz",
    "commitlint": "commitlint --edit",
    "docker:build": "docker build . -t ulti-project-bot:latest",
    "format": "biome format --write",
    "g:slash-command": "hygen slash-command new",
    "graphql:codegen": "graphql-codegen --config codegen.ts",
    "knip": "knip",
    "lint": "biome lint --diagnostic-level=error",
    "lint:ci": "biome ci --diagnostic-level=error",
    "prepare": "node scripts/install-hooks.js",
    "start:dev:sentry": "NODE_OPTIONS=\"--import=./apps/bot/instrumentation.ts\" pnpm start:dev",
    "cli": "dotenvx run -f .env -f .env.development -- node apps/cli/src/main.ts",
    "cli:prod": "dotenvx run -f .env -f .env.production -- node apps/cli/src/main.ts",
    "start": "dotenvx run -f .env -f .env.production -- node apps/bot/dist/main.js",
    "start:dev": "dotenvx run -f .env -f .env.development -- node apps/bot/dist/main.js",
    "test": "vitest",
    "test:ci": "CI=true vitest run --coverage",
    "test:cov": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org ulti-project --project ulti-project-bot ./apps/bot/dist && sentry-cli sourcemaps upload --org ulti-project --project ulti-project-bot ./apps/bot/dist"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@dotenvx/dotenvx": "^2.21.0",
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/schema-ast": "^6.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-graphql-request": "^7.1.0",
    "@graphql-codegen/typescript-operations": "6.1.6",
    "@sentry/cli": "^3.6.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "commitizen": "^4.3.2",
    "hygen": "^6.2.11",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
