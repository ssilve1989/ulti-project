{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Native-TS library package: consumers type-check against emitted d.ts
  // ("./dist/index.d.ts") and Node 26 runs the erasable source ("./src/index.ts")
  // directly. Emits declarations only, so this stays a valid composite
  // project-reference target without shipping runnable JS.
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "erasableSyntaxOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  }
}
