{
  "name": "@ulti-project/cli",
  "version": "1.0.0",
  "description": "CLI tooling for Ulti-Project",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "cli": "dotenvx run -fk ../../.env.keys -f .env.development -f ../../.env -- node src/main.ts",
    "cli:prod": "dotenvx run -f .env -f .env.production -- node src/main.ts",
    "build:check": "tsc -b"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@ulti-project/shared": "workspace:*",
    "commander": "catalog:",
    "firebase-admin": "catalog:",
    "graphql-request": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
