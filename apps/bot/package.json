{
  "name": "@ulti-project/bot",
  "version": "2.6.4",
  "description": "Ulti-Project Discord Bot",
  "author": "Aeo <aeo.games14@gmail.com>",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build:check": "tsc -b tsconfig.typecheck.json",
    "build": "tsc -b tsconfig.build.json",
    "docker:build": "docker build -f Dockerfile -t ulti-project-bot:latest ../..",
    "graphql:codegen": "graphql-codegen --config codegen.ts",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org ulti-project --project ulti-project-bot ./dist && sentry-cli sourcemaps upload --org ulti-project --project ulti-project-bot ./dist",
    "start:dev:sentry": "NODE_OPTIONS=\"--import=./instrumentation.ts\" dotenvx run -fk ../../.env.keys -f .env.development -f ../../.env -- node dist/main.js",
    "start:dev": "dotenvx run -fk ../../.env.keys -f .env.development -f ../../.env -- node dist/main.js"
  },
  "dependencies": {
    "@googleapis/sheets": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/cqrs": "catalog:",
    "@sentry/nestjs": "catalog:",
    "@sentry/profiling-node": "catalog:",
    "@ulti-project/shared": "workspace:*",
    "cron": "catalog:",
    "discord.js": "catalog:",
    "firebase-admin": "catalog:",
    "google-auth-library": "catalog:",
    "graphql": "catalog:",
    "graphql-request": "catalog:",
    "nestjs-pino": "catalog:",
    "pino-http": "catalog:",
    "pino-pretty": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "title-case": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/schema-ast": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-codegen/typescript-graphql-request": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@nestjs/testing": "catalog:",
    "@sentry/cli": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
