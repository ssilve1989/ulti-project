{
  "$schema": "./node_modules/knip/schema-jsonc.json",

  // App entry (bootstrapped manually via NestFactory, not nest-cli — the
  // auto-enabled Nest plugin has no nest-cli.json to read, so this must be
  // explicit). codegen.ts/vitest.config.ts/test/setup.ts are already picked
  // up by knip's GraphQL Codegen and Vitest plugins, so they're omitted here.
  "entry": [
    "src/main.ts",
    "src/cli/main.ts",
    "instrumentation.ts",
    "src/**/*.spec.ts",
    // Not imported anywhere — it's a source of gql-tagged documents that
    // graphql-codegen's `documents` glob (codegen.ts) extracts into the
    // generated src/fflogs/graphql/sdk.ts. The Codegen plugin only treats
    // `generates` output keys as entries, not `documents` inputs.
    "src/fflogs/queries.ts"
  ],

  // TS project scope: everything under src/, plus root-level TS config/entry
  // scripts (codegen.ts, instrumentation.ts, vitest.config.ts).
  "project": ["src/**/*.ts", "*.ts"],

  "ignoreDependencies": [
    // Referenced only as pino's transport target string in app.module.ts
    // (`target: 'pino-pretty'`), resolved dynamically by pino at runtime —
    // never statically imported.
    "pino-pretty"
  ]
}
