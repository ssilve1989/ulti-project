{
  "$schema": "./node_modules/knip/schema-jsonc.json",

  // Monorepo: patterns below are relative to each workspace package root.
  "workspaces": {
    // App entry (bootstrapped manually via NestFactory, not nest-cli — the
    // auto-enabled Nest plugin has no nest-cli.json to read, so this must be
    // explicit). codegen.ts/vitest.config.ts/test/setup.ts are picked up by
    // knip's GraphQL Codegen and Vitest plugins at the repository root.
    "apps/bot": {
      "entry": [
        "src/main.ts",
        "instrumentation.ts",
        "src/**/*.spec.ts",
        // Not imported anywhere — it's a source of gql-tagged documents that
        // graphql-codegen's `documents` glob (codegen.ts) extracts into the
        // generated apps/bot/src/fflogs/graphql/sdk.ts; that output is marked
        // as an entry below.
        "src/fflogs/queries.ts",
        // Generated by pnpm graphql:codegen — consumed by graphql-request
        // clients via the gql-tagged documents, not via static imports, so
        // its exports must never be reported as unused.
        "src/fflogs/graphql/sdk.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "apps/cli": {
      "entry": ["src/**/*.spec.ts"],
      "project": ["src/**/*.ts"]
    },
    // Cloudflare Pages invokes route handlers by file-based routing; they are
    // never statically imported. Specs are entrypoints too.
    "apps/web": {
      "entry": ["functions/**/*.ts"],
      "project": ["functions/**/*.ts"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    }
  },

  "includeEntryExports": false,

  "ignoreDependencies": [
    // Referenced only as pino's transport target string in app.module.ts
    // (`target: 'pino-pretty'`), resolved dynamically by pino at runtime —
    // never statically imported.
    "pino-pretty"
  ]
}
